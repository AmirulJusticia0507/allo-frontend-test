# Copy to `.env.local` and adjust as needed.

# Launch Library 2 (rocket screens). Leave empty in development: the app calls
# `/launch-library` and the Vite dev server proxies it to VITE_API_PROXY_TARGET
# (see vite.config.mts). Set a full URL to call the API directly from the browser.
VITE_API_BASE_URL=

# Where the Vite dev server proxies `/launch-library` to. `lldev` has a much
# higher rate limit than the production `ll` host (15 requests/hour).
VITE_API_PROXY_TARGET=https://lldev.thespacedevs.com

# Split Bill API. Leave empty in development: the app calls `/api` and the Vite
# dev server proxies it to VITE_SPLIT_BILL_TARGET (see vite.config.mts).
VITE_SPLIT_BILL_BASE_URL=

# Where the Vite dev server proxies `/api` to (used by vite.config.mts).
VITE_SPLIT_BILL_TARGET=http://localhost:4110
