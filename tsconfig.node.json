{
  "include": ["vite.config.*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["es2023"],
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
